[Unit]
Description=Sous hosted workspace (one authority)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sous-hosted
Group=sous-hosted
UMask=0077
StateDirectory=sous-hosted
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sous-hosted
ExecStart=/opt/sous-hosted/sous hosted-hub --config /etc/sous-hosted/workspace.yaml
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
