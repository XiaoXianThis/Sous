# Copy to .env (ignored by git) and fill in. Never commit real keys.
# OpenCode Go subscription key (configs/hub.dev.yaml uses it).
OPENCODE_API_KEY=
# DeepSeek API key, if you use the deepseek provider instead.
#DEEPSEEK_API_KEY=
# Search keys, if hub.yaml's web.search.provider is brave or tavily.
#BRAVE_API_KEY=
#TAVILY_API_KEY=
