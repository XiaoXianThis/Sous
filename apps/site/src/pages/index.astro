              <div class="font-mono text-[11px] text-faint">{item.actor}</div>
              <p class="text-xs text-muted leading-relaxed">{item.desc}</p>
            </div>
            <div class="pt-2.5 border-t border-line font-mono text-[11px] text-faint break-words">
              {item.artifact}
            </div>
          </div>
        ))}
      </div>

      <!-- Architecture & Protocol Flow Diagram (Inline SVG / HTML) -->
      <div class="rounded-md bg-page border border-line p-5 sm:p-6 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="font-mono text-xs text-ink font-medium">
            HUB ↔ NODE 安全边界与通信拓扑（零入站端口）
          </div>
          <a href="/docs/architecture-overview" class="font-mono text-xs text-accent hover:underline">
            查看完整架构文档 →
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-11 gap-3 items-stretch text-xs">
          <!-- Client Endpoints -->
          <div class="lg:col-span-3 rounded-sm bg-panel border border-line p-4 space-y-2">
            <div class="font-mono text-[11px] text-faint uppercase">多端入口 (你)</div>
            <div class="text-sm font-semibold text-ink">Web 工作台 / 手机 PWA / CLI</div>
            <ul class="space-y-1 text-muted font-mono text-[11px]">
              <li>· 桌面三栏工作台 + 项目对话</li>
              <li>· iOS Liquid Glass 主屏全屏 App</li>
              <li>· 本机终端 `sous chat` 直接对话</li>
              <li>· Passkey (WebAuthn) 无密码认证</li>
            </ul>
          </div>

          <div class="lg:col-span-1 flex items-center justify-center font-mono text-faint text-xs py-1">
            <span class="hidden lg:inline">HTTPS / WSS ⇄</span>
            <span class="lg:hidden">⇅ HTTPS / WSS</span>
          </div>

          <!-- Hub -->
          <div class="lg:col-span-3 rounded-sm bg-panel border border-line-strong p-4 space-y-2">
            <div class="flex items-center justify-between font-mono text-[11px]">
              <span class="text-accent uppercase font-semibold">大脑 · sous-hub</span>
              <span class="text-faint">Linux Server</span>
            </div>
            <div class="text-sm font-semibold text-ink">思考、存储与协调中心</div>
            <ul class="space-y-1 text-muted font-mono text-[11px]">
              <li>· 事件日志 `eventlog.Log` (SQLite)</li>
              <li>· 主管 / 审批 / 验收 / 巡检模型调用</li>
              <li>· `web_search` &amp; `web_fetch` (内网防护)</li>
              <li>· 绝不执行 shell、不碰代码仓库</li>
            </ul>
          </div>

          <div class="lg:col-span-1 flex items-center justify-center font-mono text-faint text-xs py-1">
