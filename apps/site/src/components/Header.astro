---
import AgentMark from './AgentMark.astro';
import { DOC_GROUPS, REPO_URL, RELEASES_URL } from '../lib/docs-nav';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const isDocs = currentPath.startsWith('/docs');
const isChangelog = currentPath.startsWith('/changelog');
---

<header class="sticky top-0 z-40 h-nav-h bg-page/90 backdrop-blur-md border-b border-line">
  <div class="mx-auto flex h-full max-w-docs items-center justify-between px-gutter md:px-gutter-lg gap-3">
    <div class="flex items-center gap-6 min-w-0">
      <a
        href="/"
        class="inline-flex items-center gap-2.5 text-ink font-semibold tracking-tight hover:opacity-90 transition-opacity duration-fast focus:outline-none"
      >
        <AgentMark name="sous" size={24} />
        <span class="text-base font-semibold tracking-tight">sous</span>
        <span class="hidden sm:inline-block font-mono text-xs text-faint border border-line px-1.5 py-0.5 rounded-xs bg-panel">
          ACP · Hub/Node
        </span>
      </a>

      <nav aria-label="主导航" class="hidden md:flex items-center gap-5 text-sm">
        <a
          href="/"
          class:list={[
            'transition-colors duration-fast',
            currentPath === '/' ? 'text-ink font-medium' : 'text-muted hover:text-ink',
          ]}
        >
          首页
        </a>
        <a href="/#scenarios" class="text-muted hover:text-ink transition-colors duration-fast">
          使用场景
        </a>
        <a href="/#capabilities" class="text-muted hover:text-ink transition-colors duration-fast">
          核心能力
        </a>
        <a href="/#agents" class="text-muted hover:text-ink transition-colors duration-fast">
          支持 Agent
        </a>
        <a
          href="/docs"
          class:list={[
            'transition-colors duration-fast',
            isDocs ? 'text-accent font-medium' : 'text-muted hover:text-ink',
          ]}
        >
          文档
        </a>
        <a
          href="/changelog"
          class:list={[
            'transition-colors duration-fast',
            isChangelog ? 'text-accent font-medium' : 'text-muted hover:text-ink',
          ]}
        >
          更新日志
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-2 flex-none">
      <button
        type="button"
        data-open-search
        class="inline-flex items-center gap-2 h-8 px-2.5 rounded-sm bg-panel border border-line hover:border-line-strong text-xs text-muted hover:text-ink transition-colors duration-fast"
        aria-label="搜索文档"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <span class="hidden sm:inline">搜索文档</span>
        <kbd class="hidden sm:inline-block font-mono text-[11px] text-faint border border-line px-1 rounded-xs bg-sunken">
          ⌘K
        </kbd>
      </button>

      <button
        type="button"
        data-theme-toggle
        class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-sm bg-panel border border-line hover:border-line-strong text-xs text-muted hover:text-ink transition-colors duration-fast"
        aria-label="切换主题（深色 / 浅色 / 跟随系统）"
        title="切换深浅色主题"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <span data-theme-label class="hidden lg:inline font-mono text-[11px]">系统</span>
      </button>

      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 h-8 px-2.5 rounded-sm bg-panel border border-line hover:border-line-strong text-xs text-ink font-medium transition-colors duration-fast"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.92.58.1.79-.25.79-.56v-2.02c-3.2.7-3.88-1.38-3.88-1.38-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
        <span>GitHub</span>
      </a>

      <button
        type="button"
        data-drawer-open
        class="inline-flex md:hidden items-center justify-center w-8 h-8 rounded-sm bg-panel border border-line text-ink"
        aria-label="打开导航菜单"
        aria-controls="mobile-nav-drawer"
        aria-expanded="false"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Slide-over Drawer -->
<div
  id="mobile-nav-drawer"
  class="fixed inset-0 z-50 hidden md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="移动端导航菜单"
>
  <div data-drawer-backdrop class="fixed inset-0 bg-black/60 backdrop-blur-xs"></div>
  <aside class="fixed top-0 right-0 bottom-0 w-[min(84vw,320px)] bg-page border-l border-line flex flex-col justify-between overflow-y-auto p-5">
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-4 border-b border-line">
        <a href="/" class="inline-flex items-center gap-2 text-ink font-semibold">
          <AgentMark name="sous" size={22} />
          <span>sous</span>
        </a>
        <button
          type="button"
          data-drawer-close
          class="inline-flex items-center justify-center w-8 h-8 rounded-sm bg-panel border border-line text-muted hover:text-ink"
          aria-label="关闭导航菜单"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <nav aria-label="移动端主导航" class="space-y-1">
        <p class="font-mono text-[11px] uppercase tracking-wider text-faint px-2 pb-1">站点导航</p>
        <a href="/" data-drawer-link class="block px-2.5 py-2 rounded-sm text-sm text-ink hover:bg-hover">
          首页
        </a>
        <a href="/#scenarios" data-drawer-link class="block px-2.5 py-2 rounded-sm text-sm text-muted hover:text-ink hover:bg-hover">
          三个使用场景
        </a>
        <a href="/#capabilities" data-drawer-link class="block px-2.5 py-2 rounded-sm text-sm text-muted hover:text-ink hover:bg-hover">
          核心能力
        </a>
        <a href="/#workflow" data-drawer-link class="block px-2.5 py-2 rounded-sm text-sm text-muted hover:text-ink hover:bg-hover">
          五步工作流
        </a>
        <a href="/#agents" data-drawer-link class="block px-2.5 py-2 rounded-sm text-sm text-muted hover:text-ink hover:bg-hover">
          支持的编程 Agent
        </a>
        <a href="/docs" data-drawer-link class="block px-2.5 py-2 rounded-sm text-sm text-accent font-medium hover:bg-hover">
          文档中心 (/docs)
        </a>
        <a href="/changelog" data-drawer-link class="block px-2.5 py-2 rounded-sm text-sm text-muted hover:text-ink hover:bg-hover">
          版本更新日志 (/changelog)
        </a>
      </nav>

      <div class="space-y-3 pt-2 border-t border-line">
        <p class="font-mono text-[11px] uppercase tracking-wider text-faint px-2">文档分组</p>
        {DOC_GROUPS.map((group) => (
          <div class="px-2 space-y-1">
            <div class="text-xs font-semibold text-ink flex items-center gap-1.5">
              <span class="font-mono text-faint">{group.code}</span>
              <span>{group.title}</span>
            </div>
            <ul class="space-y-1 pl-4 border-l border-line">
              {group.items.map((item) => (
                <li>
                  <a
                    href={`/docs/${item.slug}`}
                    data-drawer-link
                    class="block py-1 text-xs text-muted hover:text-accent"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="pt-4 mt-6 border-t border-line flex items-center justify-between gap-2">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-panel border border-line text-xs text-ink"
      >
        <span>GitHub 仓库</span>
        <span class="text-faint">↗</span>
      </a>
      <a
        href={RELEASES_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-accent text-accent-ink font-medium text-xs"
      >
        <span>Releases</span>
      </a>
    </div>
  </aside>
</div>
