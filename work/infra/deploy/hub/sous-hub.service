# systemd unit for the sous Hub. Install to /etc/systemd/system/sous-hub.service.
# Expects the layout from docs/guides/deploy-hub.md:
#   /opt/sous/sous-hub     the binary
#   /opt/sous/hub.yaml     config (from apps/core/configs/hub.example.yaml)
#   /opt/sous/web/         the built PWA (build/web)
#   /etc/sous/hub.env      secrets such as DEEPSEEK_API_KEY (mode 600)
[Unit]
Description=sous Hub
After=network-online.target
Wants=network-online.target

[Service]
User=sous
Group=sous
WorkingDirectory=/opt/sous
EnvironmentFile=/etc/sous/hub.env
ExecStart=/opt/sous/sous-hub -config /opt/sous/hub.yaml
Restart=always
RestartSec=3

# Hardening: the Hub only needs its own data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/sous/data /var/backups/sous

[Install]
WantedBy=multi-user.target
