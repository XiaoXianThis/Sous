---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { GROUP_RANK } from '../../lib/docs-nav';

export async function getStaticPaths() {
  const entries = await getCollection('docs');

  const sorted = [...entries].sort((a, b) => {
    const gDiff = GROUP_RANK[a.data.group] - GROUP_RANK[b.data.group];
    if (gDiff !== 0) return gDiff;
    return a.data.order - b.data.order;
  });

  return sorted.map((entry, idx) => {
    const prev = idx > 0 ? sorted[idx - 1] : null;
    const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prevDoc: prev
          ? { slug: prev.id, title: prev.data.title, group: prev.data.group }
          : null,
        nextDoc: next
          ? { slug: next.id, title: next.data.title, group: next.data.group }
          : null,
      },
    };
  });
}

const { entry, prevDoc, nextDoc } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  group={entry.data.group}
  sourceDoc={entry.data.sourceDoc}
  updatedAt={entry.data.updatedAt}
  headings={headings}
  currentSlug={entry.id}
  prevDoc={prevDoc}
  nextDoc={nextDoc}
>
  <Content />
</DocsLayout>
