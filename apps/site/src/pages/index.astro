              <li>· 挂载 `sous mcp` 供子 Agent 报进度/提问</li>
              <li>· 维护独立 `worktrees/` 与 `outbox.jsonl`</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported Agents Section -->
  <section id="agents" class="border-b border-line py-section bg-page">
