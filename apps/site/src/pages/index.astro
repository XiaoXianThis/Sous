                <code class="text-ink text-right break-all">{ag.launch}</code>
              </div>
              <div class="flex items-start justify-between gap-2">
                <span class="text-faint flex-none">登录：</span>
                <code class="text-muted text-right break-all">{ag.loginCmd}</code>
              </div>
              <div class="flex items-start justify-between gap-2">
