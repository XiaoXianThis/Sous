---
import { withBase } from '../lib/with-base';
import BaseLayout from './BaseLayout.astro';
import { DOC_GROUPS, GROUP_LABELS, REPO_URL, type DocGroupKey } from '../lib/docs-nav';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface NavDoc {
  slug: string;
  title: string;
  group: DocGroupKey;
}

interface Props {
  title: string;
  description: string;
  group: DocGroupKey;
  sourceDoc?: string;
  updatedAt?: string;
  headings?: Heading[];
  currentSlug: string;
  prevDoc?: NavDoc | null;
  nextDoc?: NavDoc | null;
}

const {
  title,
  description,
  group,
  sourceDoc,
  updatedAt,
  headings = [],
  currentSlug,
  prevDoc = null,
  nextDoc = null,
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const editUrl = `${REPO_URL}/edit/main/apps/site/src/content/docs/${currentSlug}.md`;
---

<BaseLayout title={`${title} · 文档`} description={description}>
  <div class="mx-auto max-w-docs px-gutter md:px-gutter-lg">
    <!-- Mobile Doc Navigation & TOC Bar -->
    <div class="lg:hidden py-3 border-b border-line flex flex-col gap-2">
      <div class="flex items-center justify-between gap-2">
        <a href={withBase('/docs/')} class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-ink font-mono">
          <span>←</span>
          <span>文档索引</span>
          <span class="text-faint">/</span>
          <span class="text-accent">{GROUP_LABELS[group]}</span>
        </a>
        <button
          type="button"
          data-open-search
          class="inline-flex items-center gap-1.5 px-2 py-1 rounded-xs bg-panel border border-line text-xs text-muted"
        >
          <span>搜索文档</span>
          <span class="font-mono text-[10px] text-faint">⌘K</span>
        </button>
      </div>

      <details class="group rounded-sm bg-panel border border-line">
        <summary class="cursor-pointer list-none px-3 py-2 text-xs font-medium text-ink flex items-center justify-between">
          <span>切换文档章节 / 本页目录</span>
          <span class="font-mono text-faint group-open:rotate-180 transition-transform duration-fast">▾</span>
        </summary>
        <div class="px-3 pb-3 pt-1 border-t border-line space-y-3 text-xs">
          {tocHeadings.length > 0 && (
            <div class="space-y-1">
              <div class="font-mono text-[11px] text-faint">本页目录</div>
              <ul class="space-y-1 pl-2 border-l border-line">
                {tocHeadings.map((h) => (
                  <li class={h.depth === 3 ? 'pl-3' : ''}>
                    <a href={`#${h.slug}`} class="block py-0.5 text-muted hover:text-accent">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <div class="space-y-2">
            <div class="font-mono text-[11px] text-faint">全部章节（7 大类）</div>
            {DOC_GROUPS.map((g) => (
              <div class="space-y-1">
                <div class="font-medium text-ink">{g.code} · {g.title}</div>
                <ul class="space-y-1 pl-2 border-l border-line">
                  {g.items.map((item) => (
                    <li>
                      <a
                        href={withBase(`/docs/${item.slug}/`)}
                        aria-current={item.slug === currentSlug ? 'page' : undefined}
                        class:list={[
                          'block py-0.5',
                          item.slug === currentSlug ? 'text-accent font-medium' : 'text-muted hover:text-ink',
                        ]}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </details>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 py-8 lg:py-10">
      <!-- Left Sidebar -->
      <aside class="hidden lg:block lg:col-span-3 xl:col-span-3 border-r border-line pr-6">
        <div class="sticky top-20 space-y-6 max-h-[calc(100dvh-6rem)] overflow-y-auto pr-1">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <a href={withBase('/docs/')} class="font-mono text-xs uppercase tracking-wider text-faint hover:text-ink transition-colors duration-fast">
                DOCS INDEX
              </a>
              <span class="font-mono text-[11px] text-faint">7 Groups</span>
            </div>
            <div class="relative">
              <input
                id="sidebar-filter-input"
                type="search"
                placeholder="过滤侧栏章节…"
                aria-label="过滤侧栏章节"
                class="w-full h-8 px-2.5 rounded-sm bg-panel border border-line text-xs text-ink placeholder:text-faint focus:outline-none focus:border-accent"
              />
            </div>
          </div>

          <nav aria-label="文档侧边栏" id="docs-sidebar-nav" class="space-y-5">
            {DOC_GROUPS.map((g) => (
              <div data-sidebar-group class="space-y-1.5">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-ink px-2">
                  <span class="font-mono text-faint">{g.code}</span>
                  <span>{g.title}</span>
                </div>
                <ul class="space-y-0.5 border-l border-line ml-2 pl-2">
                  {g.items.map((item) => {
                    const active = item.slug === currentSlug;
                    return (
                      <li data-sidebar-item data-title={`${item.title} ${item.description}`.toLowerCase()}>
                        <a
                          href={withBase(`/docs/${item.slug}/`)}
                          aria-current={active ? 'page' : undefined}
                          class:list={[
                            'block px-2.5 py-1.5 rounded-sm text-xs transition-colors duration-fast',
                            active
                              ? 'bg-accent-soft text-accent font-medium'
                              : 'text-muted hover:text-ink hover:bg-hover',
                          ]}
                        >
                          {item.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Article Content -->
      <main class="lg:col-span-9 xl:col-span-6 min-w-0">
        <article class="max-w-prose">
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-faint mb-3">
            <a href={withBase('/docs/')} class="hover:text-ink">文档</a>
            <span>/</span>
            <span class="text-accent">{GROUP_LABELS[group]}</span>
            {updatedAt && (
              <>
                <span>·</span>
                <span>更新于 {updatedAt}</span>
              </>
            )}
            <div class="ml-auto flex items-center gap-2">
              {sourceDoc && (
                <a
                  href={`${REPO_URL}/blob/main/${sourceDoc}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 px-2 py-0.5 rounded-xs bg-panel border border-line text-[11px] text-muted hover:text-ink"
                >
                  <span>参考: {sourceDoc}</span>
                  <span>↗</span>
                </a>
              )}
              <a
                href={editUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-xs bg-panel border border-line text-[11px] text-muted hover:text-accent"
              >
                <span>编辑此页</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink">
            {title}
          </h1>
          <p class="mt-2.5 text-base text-muted leading-relaxed pb-6 border-b border-line">
            {description}
          </p>

          <div class="doc-prose mt-6" id="doc-prose-body">
            <slot />
          </div>

          <!-- Edit this page footer bar -->
          <div class="mt-10 pt-4 border-t border-line flex flex-wrap items-center justify-between gap-2 text-xs text-faint font-mono">
            <a
              href={editUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-muted hover:text-accent transition-colors duration-fast"
            >
              <span>✎ 在 GitHub 上编辑此页（apps/site/src/content/docs/{currentSlug}.md）</span>
              <span>↗</span>
            </a>
            {updatedAt && <span>最后核对：{updatedAt}</span>}
          </div>

          <!-- Prev / Next Navigation -->
          <nav
            aria-label="上一篇与下一篇"
            class="mt-6 pt-6 border-t border-line grid grid-cols-1 sm:grid-cols-2 gap-3"
          >
            {prevDoc ? (
              <a
                href={withBase(`/docs/${prevDoc.slug}/`)}
                class="group p-4 rounded-md bg-panel border border-line hover:border-line-strong transition-colors duration-fast flex flex-col gap-1"
              >
                <span class="font-mono text-xs text-faint">← 上一篇 · {GROUP_LABELS[prevDoc.group]}</span>
                <span class="text-sm font-medium text-ink group-hover:text-accent transition-colors duration-fast">
                  {prevDoc.title}
                </span>
              </a>
            ) : (
              <a
                href={withBase('/docs/')}
                class="group p-4 rounded-md bg-panel border border-line hover:border-line-strong transition-colors duration-fast flex flex-col gap-1"
              >
                <span class="font-mono text-xs text-faint">← 返回索引</span>
                <span class="text-sm font-medium text-ink group-hover:text-accent transition-colors duration-fast">
                  文档首页（全部分组导航）
                </span>
              </a>
            )}

            {nextDoc ? (
              <a
                href={withBase(`/docs/${nextDoc.slug}/`)}
                class="group p-4 rounded-md bg-panel border border-line hover:border-line-strong transition-colors duration-fast flex flex-col gap-1 sm:text-right"
              >
                <span class="font-mono text-xs text-faint">下一篇 · {GROUP_LABELS[nextDoc.group]} →</span>
                <span class="text-sm font-medium text-ink group-hover:text-accent transition-colors duration-fast">
                  {nextDoc.title}
                </span>
              </a>
            ) : (
              <a
                href={withBase('/docs/')}
                class="group p-4 rounded-md bg-panel border border-line hover:border-line-strong transition-colors duration-fast flex flex-col gap-1 sm:text-right"
              >
                <span class="font-mono text-xs text-faint">浏览更多 →</span>
                <span class="text-sm font-medium text-ink group-hover:text-accent transition-colors duration-fast">
                  返回文档分组导航
                </span>
              </a>
            )}
          </nav>
        </article>
      </main>

      <!-- Right Table of Contents -->
      <aside class="hidden xl:block xl:col-span-3 pl-4">
        <div class="sticky top-20 space-y-4">
          <div class="font-mono text-xs uppercase tracking-wider text-faint">
            本页目录
          </div>
          {tocHeadings.length > 0 ? (
            <ul class="space-y-1.5 text-xs border-l border-line pl-3">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? 'pl-3' : ''}>
                  <a
                    href={`#${h.slug}`}
                    class="block py-0.5 text-muted hover:text-accent transition-colors duration-fast leading-snug"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-xs text-faint">本页无二级章节</p>
          )}

          <div class="pt-4 border-t border-line space-y-2">
            <a
              href={editUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between px-3 py-2 rounded-sm bg-panel border border-line hover:border-line-strong text-xs text-muted hover:text-ink transition-colors duration-fast"
            >
              <span>编辑此页</span>
              <span class="font-mono text-[10px] text-faint">GitHub ↗</span>
            </a>
            <button
              type="button"
              data-open-search
              class="w-full flex items-center justify-between px-3 py-2 rounded-sm bg-panel border border-line hover:border-line-strong text-xs text-muted hover:text-ink transition-colors duration-fast"
            >
              <span>全文检索文档</span>
              <kbd class="font-mono text-[10px] text-faint">⌘K</kbd>
            </button>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    (() => {
      // Sidebar filter
      const filterInput = document.getElementById('sidebar-filter-input');
      if (filterInput) {
        filterInput.addEventListener('input', () => {
          const q = (filterInput.value || '').trim().toLowerCase();
          document.querySelectorAll('[data-sidebar-group]').forEach((groupEl) => {
            let visibleCount = 0;
            groupEl.querySelectorAll('[data-sidebar-item]').forEach((itemEl) => {
              const text = itemEl.getAttribute('data-title') || '';
              const match = !q || text.includes(q);
              itemEl.style.display = match ? '' : 'none';
              if (match) visibleCount++;
            });
            groupEl.style.display = visibleCount > 0 ? '' : 'none';
          });
        });
      }

      // Add clickable anchor links (#) to headings in article prose
      const prose = document.getElementById('doc-prose-body');
      if (prose) {
        prose.querySelectorAll('h2[id], h3[id]').forEach((heading) => {
          const id = heading.getAttribute('id');
          if (!id || heading.querySelector('.heading-anchor')) return;
          const anchor = document.createElement('a');
          anchor.href = `#${id}`;
          anchor.className =
            'heading-anchor ml-2 font-mono text-xs text-faint hover:text-accent no-underline opacity-60 hover:opacity-100 transition-opacity';
          anchor.setAttribute('aria-label', '章节锚点链接');
          anchor.textContent = '#';
          heading.appendChild(anchor);
        });
      }
    })();
  </script>
</BaseLayout>
